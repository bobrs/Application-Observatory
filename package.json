{
  "name": "application-observatory",
  "version": "0.1.0-increment.5",
  "private": true,
  "type": "module",
  "license": "CC0-1.0",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "start": "node dist/server.js",
    "exercise": "node dist/server.js --exercise",
    "test": "node --test test/*.test.mjs",
    "verify": "npm run typecheck && npm run build && npm test",
    "demo": "node scripts/capture-demo.mjs",
    "demo:exercise": "node scripts/capture-exercise.mjs",
    "reference": "node dist/server.js --reference",
    "demo:reference": "node scripts/capture-reference.mjs",
    "demo:portfolio": "node scripts/capture-portfolio.mjs",
    "demo:refinement": "node scripts/capture-refinement.mjs"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "fastify": "5.12.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.2",
    "playwright": "1.64.1",
    "typescript": "7.0.2"
  }
}
